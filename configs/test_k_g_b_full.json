{
  "metadata": {
    "description": "Test configuration for K+G+B (full calibration chain)",
    "version": "1.0",
    "use_case": "Full wideband calibration validation"
  },
  "jones_chain": {
    "order": ["bandpass", "gain"],
    "enabled_effects": ["bandpass", "gain"]
  },
  "effects": {
    "bandpass": {
      "type": "bandpass_amplitude_delay",
      "per_antenna": true,
      "per_polarization": true,
      "frequency_dependent": true,
      "reference_antenna": 0,
      "ref_freq": 1.5e9,
      "amplitude": {
        "x_pol": {
          "model": "trapezoidal",
          "edge_fraction": 0.1,
          "edge_rolloff": 0.8,
          "passband_ripple_amplitude": 0.03
        },
        "y_pol": {
          "model": "trapezoidal",
          "edge_fraction": 0.1,
          "edge_rolloff": 0.8,
          "passband_ripple_amplitude": 0.03
        }
      },
      "delay": {
        "tau_x": {
          "distribution": "uniform",
          "min": -10e-9,
          "max": 10e-9
        },
        "tau_y": {
          "distribution": "uniform",
          "min": -10e-9,
          "max": 10e-9
        }
      }
    },
    "gain": {
      "type": "complex_electronic_gain",
      "per_antenna": true,
      "per_polarization": true,
      "time_dependent": false,
      "reference_antenna": 0,
      "amplitude": {
        "x_pol": {
          "distribution": "log_normal",
          "mean": 1.0,
          "std": 0.2
        },
        "y_pol": {
          "distribution": "log_normal",
          "mean": 0.98,
          "std": 0.2
        }
      },
      "phase": {
        "x_pol": {
          "distribution": "uniform",
          "min": -1.0,
          "max": 1.0
        },
        "y_pol": {
          "distribution": "uniform",
          "min": -1.0,
          "max": 1.0
        }
      }
    }
  },
  "noise": {
    "enabled": true,
    "thermal_noise": {
      "tsys_kelvin": 50.0,
      "aperture_efficiency": 0.7,
      "antenna_diameter_meters": 25.0
    },
    "random_seed": 47
  },
  "processing": {
    "use_gpu": false,
    "gpu_device": 0,
    "chunk_size_rows": 100000,
    "batch_gpu_size": 10000,
    "random_seed": 47
  },
  "validation": {
    "solve_sequence": ["K", "G", "B"],
    "expected_rms_ns": 0.05,
    "expected_amp_rms": 0.05,
    "expected_phase_rms_deg": 5.0,
    "casa_comparison_tolerance": 0.2,
    "min_channels": 64,
    "with_noise": true
  }
}
