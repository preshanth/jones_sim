{
  "metadata": {
    "description": "Test configuration for K+G (delay + gain) calibration",
    "version": "1.0",
    "use_case": "Sequential calibration: K then G"
  },
  "jones_chain": {
    "order": ["bandpass", "gain"],
    "enabled_effects": ["bandpass", "gain"]
  },
  "effects": {
    "bandpass": {
      "type": "bandpass_amplitude_delay",
      "per_antenna": true,
      "per_polarization": false,
      "frequency_dependent": true,
      "reference_antenna": 0,
      "ref_freq": 0.0,
      "delay": {
        "tau_x": {
          "distribution": "uniform",
          "min": -10e-9,
          "max": 10e-9
        },
        "tau_y": {
          "distribution": "uniform",
          "min": -10e-9,
          "max": 10e-9
        }
      }
    },
    "gain": {
      "type": "complex_electronic_gain",
      "per_antenna": true,
      "per_polarization": true,
      "time_dependent": false,
      "reference_antenna": 0,
      "amplitude": {
        "x_pol": {
          "distribution": "log_normal",
          "mean": 1.0,
          "std": 0.3
        },
        "y_pol": {
          "distribution": "log_normal",
          "mean": 0.98,
          "std": 0.3
        }
      },
      "phase": {
        "x_pol": {
          "distribution": "uniform",
          "min": -0.5,
          "max": 0.5
        },
        "y_pol": {
          "distribution": "uniform",
          "min": -0.5,
          "max": 0.5
        }
      }
    }
  },
  "noise": {
    "enabled": false,
    "thermal_noise": {
      "tsys_kelvin": 50.0,
      "aperture_efficiency": 0.7,
      "antenna_diameter_meters": 25.0
    },
    "random_seed": 46
  },
  "processing": {
    "use_gpu": false,
    "gpu_device": 0,
    "chunk_size_rows": 100000,
    "batch_gpu_size": 10000,
    "random_seed": 46
  },
  "validation": {
    "solve_sequence": ["K", "G"],
    "expected_rms_ns": 0.01,
    "expected_amp_rms": 0.02,
    "expected_phase_rms_deg": 2.0,
    "casa_comparison_tolerance": 0.1
  }
}
