{
  "metadata": {
    "description": "Example Jones corruption configuration",
    "version": "1.0",
    "author": "jones_sim"
  },
  "jones_chain": {
    "order": [
      "parallactic",
      "leakage",
      "crosshand_phase",
      "xy_delay",
      "bandpass",
      "gain"
    ],
    "enabled_effects": [
      "gain"
    ]
  },
  "effects": {
    "parallactic": {
      "type": "parallactic_rotation",
      "per_antenna": true,
      "source": "compute_from_ms",
      "angles": 0.0
    },
    "leakage": {
      "type": "feed_leakage",
      "per_antenna": true,
      "d_xy": {
        "distribution": "complex_gaussian",
        "mean_real": 0.1,
        "mean_imag": 0.1,
        "std_real": 0.01,
        "std_imag": 0.01
      },
      "d_yx": {
        "distribution": "complex_gaussian",
        "mean_real": 0.1,
        "mean_imag": 0.1,
        "std_real": 0.01,
        "std_imag": 0.01
      },
      "theta": 0.0
    },
    "crosshand_phase": {
      "type": "xy_phase_offset",
      "per_antenna": true,
      "reference_antenna": 0,
      "phi": {
        "distribution": "uniform",
        "min": -0.1,
        "max": 0.1
      }
    },
    "xy_delay": {
      "type": "xy_differential_delay",
      "per_antenna": true,
      "frequency_dependent": true,
      "reference_antenna": 0,
      "ref_freq": 1e9,
      "delta_tau": {
        "distribution": "gaussian",
        "mean": 0.0,
        "std": 1e-9
      }
    },
    "bandpass": {
      "type": "bandpass_amplitude_delay",
      "per_antenna": true,
      "per_polarization": true,
      "frequency_dependent": true,
      "reference_antenna": 0,
      "ref_freq": 0.0,
      "amplitude": {
        "x_pol": {
          "model": "trapezoidal",
          "edge_fraction": 0.1,
          "edge_rolloff": 0.8,
          "passband_ripple_amplitude": 0.02
        },
        "y_pol": {
          "model": "trapezoidal",
          "edge_fraction": 0.1,
          "edge_rolloff": 0.8,
          "passband_ripple_amplitude": 0.02
        }
      },
      "delay": {
        "tau_x": {
          "distribution": "uniform",
          "min": -5e-9,
          "max": 5e-9
        },
        "tau_y": {
          "distribution": "uniform",
          "min": -5e-9,
          "max": 5e-9
        }
      }
    },
    "gain": {
      "type": "complex_electronic_gain",
      "per_antenna": true,
      "per_polarization": true,
      "time_dependent": false,
      "reference_antenna": 0,
      "amplitude": {
        "x_pol": {
          "distribution": "log_normal",
          "mean": 1.0,
          "std": 0.05
        },
        "y_pol": {
          "distribution": "log_normal",
          "mean": 0.98,
          "std": 0.05
        }
      },
      "phase": {
        "x_pol": {
          "distribution": "uniform",
          "min": -3.14159,
          "max": 3.14159
        },
        "y_pol": {
          "distribution": "uniform",
          "min": -3.14159,
          "max": 3.14159
        }
      }
    }
  },
  "noise": {
    "enabled": true,
    "thermal_noise": {
      "tsys_kelvin": 50.0,
      "aperture_efficiency": 0.7,
      "antenna_diameter_meters": 25.0
    },
    "random_seed": 42
  },
  "processing": {
    "use_gpu": true,
    "gpu_device": 0,
    "chunk_size_rows": 100000,
    "batch_gpu_size": 10000,
    "random_seed": 42
  }
}
