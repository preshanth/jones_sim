{
  "metadata": {
    "description": "Test configuration for G (gain) calibration only",
    "version": "1.0",
    "use_case": "Gain recovery validation"
  },
  "jones_chain": {
    "order": ["gain"],
    "enabled_effects": ["gain"]
  },
  "effects": {
    "gain": {
      "type": "complex_electronic_gain",
      "per_antenna": true,
      "per_polarization": true,
      "time_dependent": false,
      "reference_antenna": 0,
      "amplitude": {
        "x_pol": {
          "distribution": "log_normal",
          "mean": 1.0,
          "std": 0.1
        },
        "y_pol": {
          "distribution": "log_normal",
          "mean": 0.98,
          "std": 0.1
        }
      },
      "phase": {
        "x_pol": {
          "distribution": "uniform",
          "min": -0.5,
          "max": 0.5
        },
        "y_pol": {
          "distribution": "uniform",
          "min": -0.5,
          "max": 0.5
        }
      }
    }
  },
  "noise": {
    "enabled": false,
    "thermal_noise": {
      "tsys_kelvin": 50.0,
      "aperture_efficiency": 0.7,
      "antenna_diameter_meters": 25.0
    },
    "random_seed": 43
  },
  "processing": {
    "use_gpu": false,
    "gpu_device": 0,
    "chunk_size_rows": 100000,
    "batch_gpu_size": 10000,
    "random_seed": 43
  },
  "validation": {
    "expected_amp_rms": 0.01,
    "expected_phase_rms_deg": 1.0,
    "casa_comparison_tolerance": 0.05
  }
}
